{
	"name": "aicleaner",
	"version": "1.0.0",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=24.0.0 <25.0.0",
		"bun": ">=1.3.14"
	},
	"type": "module",
	"description": "Routine agent/coding harness cleanup with configurable retention.",
	"main": "index.ts",
	"scripts": {
		"start": "bun index.ts",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"typecheck": "tsc --noEmit",
		"preinstall": "only-allow bun"
	},
	"keywords": [
		"ai",
		"agent",
		"coding",
		"harness",
		"clean",
		"cleanup",
		"logs",
		"logfiles",
		"artifacts",
		"cache",
		"speed"
	],
	"author": "NomadicDaddy",
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"only-allow": "^1.2.2",
		"prettier": "3.8.3",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.0",
		"typescript": "^6.0.3"
	}
}

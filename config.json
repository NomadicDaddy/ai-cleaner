{
	"aggressive": false,
	"defaultRetention": {
		"keepCount": 5
	},
	"presets": {
		"agent-browser": [],
		"agents": [],
		"antigravity": [],
		"claude-code": [
			{
				"kind": "any",
				"name": "Claude Code project sessions",
				"paths": ["./.claude/sessions"],
				"tool": "claude-code"
			},
			{
				"kind": "any",
				"name": "Claude Code disposable global artifacts",
				"paths": [
					"~/.claude/cache",
					"~/.claude/debug",
					"~/.claude/logs",
					"~/.claude/session-reports",
					"~/.claude/shell-snapshots",
					"~/.claude/telemetry"
				],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "claude-code"
			}
		],
		"cline": [
			{
				"kind": "directory",
				"name": "Cline project task history",
				"paths": ["./.cline/tasks"],
				"tool": "cline"
			},
			{
				"kind": "directory",
				"name": "Cline session directories",
				"paths": ["~/.cline/data/sessions"],
				"risk": "aggressive",
				"tool": "cline"
			}
		],
		"codex": [
			{
				"kind": "any",
				"name": "Codex disposable global artifacts",
				"paths": ["~/.codex/cache", "~/.codex/log", "~/.codex/tmp", "~/.codex/.tmp"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "codex"
			}
		],
		"copilot": [],
		"cursor": [
			{
				"kind": "any",
				"name": "Cursor project history",
				"paths": ["./.cursor/history", "./.cursor/sessions"],
				"tool": "cursor"
			},
			{
				"kind": "any",
				"name": "Cursor cache and logs",
				"paths": ["~/AppData/Roaming/Cursor/logs", "~/AppData/Roaming/Cursor/CachedData"],
				"risk": "aggressive",
				"tool": "cursor"
			}
		],
		"devin": [
			{
				"kind": "directory",
				"name": "Devin editor logs",
				"paths": ["~/AppData/Roaming/devin/logs"],
				"retention": {
					"keepCount": 5
				},
				"risk": "aggressive",
				"tool": "devin"
			},
			{
				"kind": "any",
				"name": "Devin CLI logs and crash reports",
				"paths": [
					"~/AppData/Roaming/devin/cli/logs",
					"~/AppData/Roaming/devin/Crashpad/reports"
				],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "devin"
			},
			{
				"kind": "directory",
				"name": "Devin superseded build caches",
				"paths": ["~/AppData/Roaming/devin/CachedData"],
				"retention": {
					"keepCount": 2
				},
				"risk": "aggressive",
				"tool": "devin"
			},
			{
				"kind": "any",
				"name": "Devin downloaded extension installers",
				"paths": ["~/AppData/Roaming/devin/CachedExtensionVSIXs"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "devin"
			},
			{
				"kind": "any",
				"name": "Devin editor shell caches",
				"paths": [
					"~/AppData/Roaming/devin/Cache",
					"~/AppData/Roaming/devin/Code Cache",
					"~/AppData/Roaming/devin/DawnGraphiteCache",
					"~/AppData/Roaming/devin/DawnWebGPUCache",
					"~/AppData/Roaming/devin/GPUCache"
				],
				"retention": {
					"allowEmpty": true,
					"keepCount": 0
				},
				"risk": "aggressive",
				"tool": "devin"
			},
			{
				"kind": "any",
				"name": "Devin Next editor shell caches",
				"paths": [
					"~/AppData/Roaming/Devin - Next/Cache",
					"~/AppData/Roaming/Devin - Next/DawnGraphiteCache",
					"~/AppData/Roaming/Devin - Next/DawnWebGPUCache",
					"~/AppData/Roaming/Devin - Next/GPUCache"
				],
				"retention": {
					"allowEmpty": true,
					"keepCount": 0
				},
				"risk": "aggressive",
				"tool": "devin"
			}
		],
		"gemini": [],
		"grok": [
			{
				"kind": "any",
				"name": "Grok logs and memory traces",
				"paths": ["~/.grok/logs", "~/.grok/memtrace"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "grok"
			}
		],
		"kilo": [
			{
				"kind": "any",
				"name": "Kilo logs and cache",
				"paths": ["~/.local/share/kilo/log", "~/.cache/kilo"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "kilo"
			}
		],
		"kiro": [],
		"lm-studio": [
			{
				"kind": "directory",
				"name": "LM Studio server logs",
				"paths": ["~/.lmstudio/server-logs"],
				"retention": {
					"keepCount": 3
				},
				"risk": "aggressive",
				"tool": "lm-studio"
			},
			{
				"kind": "any",
				"name": "LM Studio application logs and crash reports",
				"paths": [
					"~/AppData/Roaming/LM Studio/logs",
					"~/AppData/Roaming/LM Studio/Crashpad/reports"
				],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "lm-studio"
			},
			{
				"kind": "any",
				"name": "LM Studio Electron shell caches",
				"paths": [
					"~/AppData/Roaming/LM Studio/Cache",
					"~/AppData/Roaming/LM Studio/Code Cache",
					"~/AppData/Roaming/LM Studio/DawnGraphiteCache",
					"~/AppData/Roaming/LM Studio/DawnWebGPUCache",
					"~/AppData/Roaming/LM Studio/GPUCache"
				],
				"retention": {
					"allowEmpty": true,
					"keepCount": 0
				},
				"risk": "aggressive",
				"tool": "lm-studio"
			}
		],
		"opencode": [
			{
				"kind": "any",
				"name": "OpenCode logs and cache",
				"paths": ["~/.local/share/opencode/log", "~/.cache/opencode"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "opencode"
			}
		],
		"t3code": [
			{
				"kind": "any",
				"name": "T3 Code rotated server and desktop logs",
				"paths": ["~/.t3/userdata/logs"],
				"retention": {
					"keepCount": 5
				},
				"risk": "aggressive",
				"tool": "t3code"
			},
			{
				"kind": "file",
				"name": "T3 Code provider capability caches",
				"paths": ["~/.t3/caches"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "t3code"
			},
			{
				"kind": "any",
				"name": "T3 Code desktop shell caches",
				"paths": [
					"~/AppData/Roaming/t3code/Cache",
					"~/AppData/Roaming/t3code/Code Cache",
					"~/AppData/Roaming/t3code/DawnGraphiteCache",
					"~/AppData/Roaming/t3code/DawnWebGPUCache",
					"~/AppData/Roaming/t3code/GPUCache"
				],
				"retention": {
					"allowEmpty": true,
					"keepCount": 0
				},
				"risk": "aggressive",
				"tool": "t3code"
			},
			{
				"kind": "any",
				"name": "T3 Code stale pending updates",
				"paths": ["~/AppData/Local/t3code-updater/pending"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "t3code"
			}
		],
		"windsurf": [],
		"zcode": [
			{
				"kind": "any",
				"name": "Zcode logs and archived crashes",
				"paths": ["~/.zcode/cli/log", "~/.zcode/v2/logs", "~/.zcode/v2/crash/archive"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "zcode"
			}
		]
	},
	"targets": [
		{
			"kind": "any",
			"name": "Local harness logs",
			"paths": ["./test-harness/logs"],
			"retention": {
				"keepCount": 2
			},
			"risk": "aggressive",
			"tool": "test-harness"
		}
	]
}

{
	"name": "ai-cleaner",
	"version": "1.1.0",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"type": "module",
	"description": "Routine agent/coding harness cleanup with configurable retention.",
	"bin": {
		"ai-cleaner": "./index.ts"
	},
	"files": [
		"CHANGELOG.md",
		"README.md",
		"config.json",
		"index.ts"
	],
	"scripts": {
		"start": "bun index.ts",
		"build": "bun run build:bundle && bun run build:verify",
		"build:bundle": "bun build ./index.ts --target=bun --outfile ./dist/ai-cleaner.js",
		"build:verify": "bun ./dist/ai-cleaner.js --help && bun ./dist/ai-cleaner.js",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"smoke:qc": "bun run format:check && bun run typecheck && bun test && bun run build",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"ai",
		"agent",
		"coding",
		"harness",
		"clean",
		"cleanup",
		"logs",
		"logfiles",
		"artifacts",
		"cache",
		"speed"
	],
	"author": "NomadicDaddy",
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "26.1.1",
		"prettier": "3.9.5",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "6.0.3"
	}
}

#!/usr/bin/env bash
# Thin wrapper: the guards own the logic, this owns only the wiring.
#
# git passes the remote name/URL as $1/$2 and the ref updates on stdin. Stdin is captured once
# and replayed into each guard, because a guard that reads it would otherwise starve the next.
#
# If a repository grows its own pre-push checks, chain them here rather than replacing this file —
# core.hooksPath allows exactly one pre-push, so an overwrite silently disables the guards.
#
# Screenshot capture is package-capability gated. The shared screenshot-guard.sh stays
# byte-identical with AIDD/Spernakit for fleet identity, but it is only invoked when this
# package defines a non-empty `smoke:screenshots` script. CLIs and other non-UI packages
# print `screenshot guard: not applicable` and continue; they must not hard-fail version tags
# for an un-runnable UI workflow.
set -euo pipefail

hooks_dir="$(dirname "$0")"
refs="$(cat)"

echo "pre-push: aidd history guard"
printf '%s\n' "$refs" | bash "$hooks_dir/aidd-history-guard.sh" "${1:-origin}"

# Non-empty script value only — empty string or missing key is not a capture workflow.
if [ -f package.json ] && grep -Eq '"smoke:screenshots"[[:space:]]*:[[:space:]]*"[^[:space:]"][^"]*"' package.json; then
	echo "pre-push: screenshot guard"
	printf '%s\n' "$refs" | bash "$hooks_dir/screenshot-guard.sh"
else
	echo "pre-push: screenshot guard: not applicable"
fi

echo "pre-push: passed"

{
	"name": "ai-cleaner",
	"version": "1.2.0",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2"
	},
	"type": "module",
	"description": "Routine agent/coding harness cleanup with configurable retention.",
	"bin": {
		"ai-cleaner": "./index.ts"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"config.json",
		"index.ts",
		"src/"
	],
	"scripts": {
		"start": "bun --no-env-file index.ts",
		"build": "bun run build:bundle && bun run build:verify && bun run build:verify-package",
		"build:bundle": "bun build ./index.ts --target=bun --outfile ./dist/ai-cleaner.js",
		"build:verify": "bun ./scripts/verify-build.ts",
		"build:verify-package": "bun ./scripts/verify-package.ts",
		"check:leak-guard": "bun ./scripts/run-bash.ts scripts/check-leak-guard.sh",
		"deploy": "bun -e \"console.error('No remote deployment target is configured. Run locally with bun run start.'); process.exit(1)\"",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"lint": "eslint index.ts src test scripts eslint.config.js --report-unused-disable-directives --max-warnings 0",
		"smoke:qc": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"preinstall": "bun scripts/require-bun.ts",
		"prepare": "(git config core.hooksPath .githooks && bun ./scripts/run-bash.ts .githooks/leak-guard-setup.sh) || true"
	},
	"keywords": [
		"ai",
		"agent",
		"coding",
		"harness",
		"clean",
		"cleanup",
		"logs",
		"logfiles",
		"artifacts",
		"cache",
		"speed"
	],
	"author": "NomadicDaddy",
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.4.2",
		"@types/node": "26.5.0",
		"eslint": "10.10.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.12.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	}
}

{
	"aggressive": false,
	"defaultRetention": {
		"keepCount": 5
	},
	"presets": {
		"agents": [],
		"antigravity": [],
		"claude-code": [
			{
				"kind": "any",
				"name": "Claude Code project sessions",
				"paths": ["./.claude/sessions"],
				"tool": "claude-code"
			},
			{
				"kind": "any",
				"name": "Claude Code disposable global artifacts",
				"paths": [
					"~/.claude/cache",
					"~/.claude/debug",
					"~/.claude/logs",
					"~/.claude/session-reports",
					"~/.claude/shell-snapshots",
					"~/.claude/telemetry"
				],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "claude-code"
			}
		],
		"cline": [
			{
				"kind": "directory",
				"name": "Cline project task history",
				"paths": ["./.cline/tasks"],
				"tool": "cline"
			},
			{
				"kind": "directory",
				"name": "Cline session directories",
				"paths": ["~/.cline/data/sessions"],
				"risk": "aggressive",
				"tool": "cline"
			}
		],
		"codex": [
			{
				"kind": "any",
				"name": "Codex disposable global artifacts",
				"paths": ["~/.codex/cache", "~/.codex/log", "~/.codex/tmp", "~/.codex/.tmp"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "codex"
			}
		],
		"copilot": [],
		"cursor": [
			{
				"kind": "any",
				"name": "Cursor project history",
				"paths": ["./.cursor/history", "./.cursor/sessions"],
				"tool": "cursor"
			},
			{
				"kind": "any",
				"name": "Cursor cache and logs",
				"paths": ["~/AppData/Roaming/Cursor/logs", "~/AppData/Roaming/Cursor/CachedData"],
				"risk": "aggressive",
				"tool": "cursor"
			}
		],
		"gemini": [],
		"grok": [
			{
				"kind": "any",
				"name": "Grok logs and memory traces",
				"paths": ["~/.grok/logs", "~/.grok/memtrace"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "grok"
			}
		],
		"kilo": [
			{
				"kind": "any",
				"name": "Kilo logs and cache",
				"paths": ["~/.local/share/kilo/log", "~/.cache/kilo"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "kilo"
			}
		],
		"kiro": [],
		"opencode": [
			{
				"kind": "any",
				"name": "OpenCode logs and cache",
				"paths": ["~/.local/share/opencode/log", "~/.cache/opencode"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "opencode"
			}
		],
		"windsurf": [],
		"zcode": [
			{
				"kind": "any",
				"name": "Zcode logs and archived crashes",
				"paths": ["~/.zcode/cli/log", "~/.zcode/v2/logs", "~/.zcode/v2/crash/archive"],
				"retention": {
					"keepDays": 14
				},
				"risk": "aggressive",
				"tool": "zcode"
			}
		]
	},
	"targets": [
		{
			"kind": "any",
			"name": "Local harness logs",
			"paths": ["./test-harness/logs"],
			"retention": {
				"keepCount": 2
			},
			"risk": "aggressive",
			"tool": "test-harness"
		}
	]
}
